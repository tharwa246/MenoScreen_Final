@page
@model MenoScreen.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Sign in";
    ViewData["HideNav"] = true;
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="login-shell">
    <section class="login-welcome mandi-gradient" aria-hidden="true">
        <p class="mandi-eyebrow">Talk to Mandi · Khuluma noMandi · Thetha noMandi · Praat met Mandi</p>
        <p class="login-headline">Thank you for arriving. <span class="accent">Let's help her feel understood.</span></p>
        <p class="login-sub">MenoScreen: a ten-minute menopause screening for your consulting room.</p>
    </section>

    <section class="login-card" aria-labelledby="login-title">
        <div class="login-brand">
            <p class="login-wordmark"><span class="brand-mark">Mandi</span> <span class="brand-product">MenoScreen</span></p>
            <p class="login-tagline">Clinical Decision Support Tool</p>
        </div>
        <h1 id="login-title">Log in</h1>
        <p class="text-secondary">For clinicians, clinic admins and patients.</p>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Log in</button>
            <p class="login-secure">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
                Role-based secure access
            </p>
        </form>

        <p class="login-help">
            Forgot your password or need an account? Ask your clinic.
            Accounts are created by the clinic, not by sign-up.
        </p>
        <p class="login-help">
            Patient with a setup code? <a asp-area="" asp-page="/Portal/Setup">Set up your account</a>.
        </p>
        <p class="login-disclaimer">
            MenoScreen is a screening aid that supports clinical judgement. It does not provide a diagnosis
            or replace a consultation with a healthcare professional.
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
