@page
@model MenoScreen.Pages.Admin.ClinicalContentModel
@{
    ViewData["Title"] = "Clinical content";
}

<a class="back-link" asp-page="/Index">Back to home</a>

<div class="page-head pt-3">
    <div>
        <h1>Clinical content</h1>
           <p>The wording for each result band: the clinician's message, and her handout on the PDF and "My health". Changes apply straight away.</p>
    </div>
</div>

@if (Model.StatusMessage != null)
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}


@* ================= 1. BAND WORDING ================= *@
<h2 id="bands" class="mb-3">Band wording</h2>
<p class="text-secondary">The band names and score ranges are set by the scoring engine. Only the wording is edited here.</p>

@foreach (var b in Model.Bands)
{
    <section class="panel mb-4" aria-label="@b.Band wording">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
            <h3 class="h4 mb-0"><span class="tag">@b.Band</span></h3>
            <span class="small text-secondary">Last changed @b.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC@(b.UpdatedBy != null ? $" by {b.UpdatedBy}" : "")</span>
        </div>
        <form method="post" asp-page-handler="SaveBand" asp-route-id="@b.Id" class="mt-3">
            <div class="mb-3">
                <label class="form-label" for="msg-@b.Id">Message on the Result page (for the clinician)</label>
                <textarea id="msg-@b.Id" name="clinicianMessage" class="form-control" rows="2" maxlength="600" required>@b.ClinicianMessage</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="sum-@b.Id">Summary on the clinician PDF</label>
                <textarea id="sum-@b.Id" name="clinicianSummary" class="form-control" rows="2" maxlength="600" required>@b.ClinicianSummary</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" for="hand-@b.Id">Her handout (her PDF page and "My health")</label>
                <textarea id="hand-@b.Id" name="patientHandout" class="form-control" rows="3" maxlength="800" required>@b.PatientHandout</textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Save @b.Band wording</button>
        </form>
    </section>
}

