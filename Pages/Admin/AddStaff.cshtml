@page
@model MenoScreen.Pages.Admin.AddStaffModel
@{
    ViewData["Title"] = "Add a staff account";
}

<a class="back-link" asp-page="AdminHome">Back to admin</a>

<div class="page-head pt-3">
    <div>
        <h1>Add a staff account</h1>
        <p>Clinicians screen patients. Admins manage questions, accounts and the audit log.</p>
    </div>
</div>

@if (Model.StatusMessage != null)
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}

<form method="post" class="panel form-narrow">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
        <div class="form-text">At least 8 characters, with an upper-case letter, a number and a symbol.</div>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Role" class="form-label"></label>
        <select asp-for="Input.Role" class="form-select">
            @foreach (var role in MenoScreen.Pages.Admin.AddStaffModel.AssignableRoles)
            {
                <option value="@role">@role</option>
            }
        </select>
        <span asp-validation-for="Input.Role" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create account</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
