@page
@model MenoScreen.Pages.Translations.ReviewModel
@using MenoScreen.Services
@{
    ViewData["Title"] = "Review translations";
}

<h1>Review: @TranslationHelper.Languages[Model.Lang] (version @Model.VersionNumber)</h1>

<p>
    <a asp-page="Index" asp-route-versionId="@Model.VersionId" class="btn btn-secondary">Back to translations</a>
</p>

<p class="text-muted">
    Edit the wording, then tick <strong>Reviewed</strong> once a fluent speaker has approved it.
    Leave a text box empty to remove that translation, so the form shows English instead.
    Answer options must have the same number of choices as English, separated by |
</p>

@if (Model.Message != null)
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (Model.Errors.Any())
{
    <div class="alert alert-danger">
        <strong>Nothing was saved:</strong>
        <ul class="mb-0">
            @foreach (var e in Model.Errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<form method="post">
    <h3>Block names</h3>
    @for (int i = 0; i < Model.Blocks.Count; i++)
    {
        <div class="row mb-2">
            <div class="col-md-5">@Model.Blocks[i].Key</div>
            <div class="col-md-7">
                <input type="hidden" name="Blocks[@i].Key" value="@Model.Blocks[i].Key" />
                <input name="Blocks[@i].Value" value="@Model.Blocks[i].Value" class="form-control" />
            </div>
        </div>
    }

    <h3 class="mt-4">Questions</h3>
    @for (int i = 0; i < Model.Items.Count; i++)
    {
        var item = Model.Items[i];
        if (!Model.English.TryGetValue(item.QuestionId, out var en)) { continue; }

        <div class="card mb-3">
            <div class="card-body">
                <input type="hidden" name="Items[@i].QuestionId" value="@item.QuestionId" />

                <p class="mb-1"><strong>@en.Number. @en.Text</strong></p>
                <textarea name="Items[@i].Text" class="form-control mb-2" rows="2">@item.Text</textarea>

                @if (!string.IsNullOrWhiteSpace(en.Options))
                {
                    <div class="form-text">English options: @en.Options</div>
                    <input name="Items[@i].Options" value="@item.Options" class="form-control mb-2" />
                }

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Items[@i].IsReviewed" value="true"
                           id="rev@(i)" checked="@item.IsReviewed" />
                    <label class="form-check-label" for="rev@(i)">Reviewed</label>
                </div>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary btn-lg">Save</button>
</form>