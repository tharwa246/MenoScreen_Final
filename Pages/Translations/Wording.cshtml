@page
@model MenoScreen.Pages.Translations.WordingModel
@using MenoScreen.Services
@{
    ViewData["Title"] = "Review wording";
}

<h1>Interface and handout wording: @TranslationHelper.Languages[Model.Lang]</h1>

<p>
    <a asp-page="Index" class="btn btn-secondary">Back to translations</a>
</p>

<p class="text-muted">
    Tick <strong>Reviewed</strong> once a fluent speaker has approved the wording. Leave a box empty to fall back to English.
    Check that <strong>JoinMandi.com</strong> appears unchanged in the handout texts.
</p>

@if (Model.Message != null)
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (Model.Errors.Any())
{
    <div class="alert alert-danger">
        <strong>Nothing was saved:</strong>
        <ul class="mb-0">
            @foreach (var e in Model.Errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<form method="post">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Key</th><th>English</th><th>@TranslationHelper.Languages[Model.Lang]</th><th>Reviewed</th></tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
                if (!Model.English.TryGetValue(item.Key, out var en)) { continue; }

                <tr>
                    <td>@item.Key</td>
                    <td>@en</td>
                    <td>
                        <input type="hidden" name="Items[@i].Key" value="@item.Key" />
                        <textarea name="Items[@i].Value" class="form-control" rows="2">@item.Value</textarea>
                    </td>
                    <td>
                        <input class="form-check-input" type="checkbox" name="Items[@i].IsReviewed" value="true"
                               checked="@item.IsReviewed" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary btn-lg">Save</button>
</form>