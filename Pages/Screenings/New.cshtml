@page "{patientId:int}"
@model MenoScreen.Pages.Screenings.NewModel
@using MenoScreen.Models
@using MenoScreen.Services
@{
    ViewData["Title"] = "New screening";
    var lang = Model.Language;
    string T(string key) => ContentService.Pick(Model.Texts, "ui." + key);
    string[] scale = { T("Scale0"), T("Scale1"), T("Scale2"), T("Scale3") };
}

<h1>Screening for @Model.Patient.FullName</h1>

<p>
    Language:
    @foreach (var l in TranslationHelper.Languages)
    {
        <a asp-page="New" asp-route-patientId="@Model.Patient.Id" asp-route-lang="@l.Key"
           class="btn btn-sm @(l.Key == lang ? "btn-primary" : "btn-outline-primary")">@l.Value</a>
    }
</p>
<p class="text-muted">Choose the language before answering. Switching language clears the form.</p>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    @foreach (var block in Model.Questions.GroupBy(q => q.BlockKey))
    {
        <h3 class="mt-4">@block.First().Block</h3>

        @if (block.First().Type == QuestionType.Scored)
        {
            <p class="text-muted">Say to the patient: "@T("ScaleIntro")"</p>
        }

        @foreach (var q in block)
        {
            <div class="mb-3">
                <label class="form-label fw-bold">@q.Number. @q.Text</label>

                @if (q.Type == QuestionType.Context)
                {
                    <select name="TextAnswers[@q.Id]" class="form-select">
                        <option value="">@T("Select")</option>
                        @foreach (var option in q.Options)
                        {
                            <option value="@option.Value" selected="@(Model.TextAnswers.GetValueOrDefault(q.Id) == option.Value)">@option.Label</option>
                        }
                    </select>
                }
                else if (q.Type == QuestionType.Scored)
                {
                    <div>
                        @for (int i = 0; i <= 3; i++)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" id="q@(q.Id)_@i"
                                       name="Answers[@q.Id]" value="@i"
                                       checked="@(Model.Answers.TryGetValue(q.Id, out var picked) && picked == i)" />
                                <label class="form-check-label" for="q@(q.Id)_@i">@i (@scale[i])</label>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="q@(q.Id)_yes"
                                   name="Answers[@q.Id]" value="1"
                                   checked="@(Model.Answers.TryGetValue(q.Id, out var s1) && s1 == 1)" />
                            <label class="form-check-label" for="q@(q.Id)_yes">@T("Yes")</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="q@(q.Id)_no"
                                   name="Answers[@q.Id]" value="0"
                                   checked="@(Model.Answers.TryGetValue(q.Id, out var s0) && s0 == 0)" />
                            <label class="form-check-label" for="q@(q.Id)_no">@T("No")</label>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <button type="submit" class="btn btn-primary btn-lg mt-3">Submit screening</button>
    <a asp-page="/Patients/Index" class="btn btn-secondary btn-lg mt-3">Cancel</a>
</form>