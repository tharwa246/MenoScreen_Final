@page "{patientId:int}"
@model MenoScreen.Pages.Screenings.NewModel
@{
    ViewData["Title"] = "New screening";
}

<a class="back-link" asp-page="/Patients/Details" asp-route-id="@Model.Patient.Id">Back to @Model.Patient.FullName</a>

<div class="page-head pt-3">
    <div>
        <h1>Screening for @Model.Patient.FullName</h1>
        <p>23 questions, about ten minutes. Read each one to her and mark her answer.</p>
    </div>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="post">
    <partial name="_QuestionFields" model="@(new MenoScreen.Pages.Shared.QuestionFormModel { Questions = Model.Questions, Answers = Model.Answers, TextAnswers = Model.TextAnswers })" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">See her result</button>
        <a asp-page="/Patients/Index" class="btn btn-quiet btn-lg">Cancel</a>
    </div>
</form>
