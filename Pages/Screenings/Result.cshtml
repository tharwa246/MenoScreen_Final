@page "{id:int}"
@model MenoScreen.Pages.Screenings.ResultModel
@using MenoScreen.Services
@{
    ViewData["Title"] = "Screening result";
}

<h1>Result for @Model.Screening.Patient.FullName</h1>
<p class="text-muted">Screened on @Model.Screening.ScreenedAt.ToString("yyyy-MM-dd HH:mm") (UTC)</p>

<div class="card mb-4">
    <div class="card-body">
        <p class="mb-1">MenoLikelihood score</p>
        <h2>@Model.Screening.MenoLikelihood / 100</h2>
        <p class="mb-1">Raw score: @Model.Screening.RawScore / @Model.MaxRaw</p>
        <p class="mb-1">Score band: <strong>@Model.Screening.ScoreBand</strong></p>
        <p class="mb-0">Final band: <strong>@Model.Screening.Band</strong></p>
    </div>
</div>

<div class="alert alert-info">@Model.Message</div>

<p>
    <a asp-page-handler="ClinicianPdf" asp-route-id="@Model.Screening.Id" class="btn btn-outline-primary">Download clinician summary (PDF)</a>
    <a asp-page-handler="HandoutPdf" asp-route-id="@Model.Screening.Id" class="btn btn-outline-primary">Download patient handout (PDF)</a>
    <a asp-page="/Patients/Index" class="btn btn-primary">Back to patients</a>
</p>

<p class="small">
    Handout in another language:
    @foreach (var l in TranslationHelper.Languages)
    {
        <a asp-page-handler="HandoutPdf" asp-route-id="@Model.Screening.Id" asp-route-lang="@l.Key" class="me-2">@l.Value</a>
    }
</p>