@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-head">
    <div>
        <h1>Something went wrong.</h1>
        <p>The page couldn't load. Go back and try again. If it keeps happening, tell your clinic admin and quote the reference below.</p>
    </div>
</div>

@if (Model.ShowRequestId)
{
    <div class="panel panel-quiet">
        <strong>Reference:</strong> <code>@Model.RequestId</code>
    </div>
}

<a class="back-link" asp-page="/Index">Back to home</a>
