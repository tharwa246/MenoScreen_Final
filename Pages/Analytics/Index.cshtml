@page
@model MenoScreen.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analytics";
    var m = Model.Summary;
    int weekMax = Math.Max(1, m.Weekly.Count == 0 ? 1 : m.Weekly.Max(w => w.Count));

    // The pie chart's data, handed to the chart script as JSON (names are safely escaped)
    var pieJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ClinicTotals.Select(c => new { id = c.ClinicId, name = c.Name, screenings = c.Screenings }));
}

<div class="page-head">
    <div>
        <h1>Clinic analytics</h1>
        <p>@Model.ScopeName. Totals across every screening; no patient names appear on this page.</p>
    </div>
</div>

@if (Model.IsAdmin && Model.ClinicTotals.Any())
{
    <section class="panel mb-4" aria-labelledby="clinics-title">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
            <div>
                <h2 id="clinics-title" class="mb-0">Screenings by clinic</h2>
                <p class="text-secondary mb-0">Click a slice, or choose a clinic, to see only that clinic below.</p>
            </div>
            <form method="get" class="d-flex gap-2">
                <label for="clinicId" class="visually-hidden">Choose a clinic</label>
                <select id="clinicId" name="clinicId" class="form-select" onchange="this.form.submit()">
                    <option value="">All clinics</option>
                    @foreach (var c in Model.ClinicTotals)
                    {
                        <option value="@c.ClinicId" selected="@(c.ClinicId == Model.ClinicId)">@c.Name</option>
                    }
                </select>
                <noscript><button type="submit" class="btn btn-quiet">Show</button></noscript>
            </form>
        </div>

        <div class="row g-4 align-items-center">
            <div class="col-md-5">
                <div class="clinic-pie">
                    <canvas id="clinicPie" role="img"
                            aria-label="Screenings by clinic: @(string.Join(", ", Model.ClinicTotals.Select(c => $"{c.Name} {c.Screenings}")))"></canvas>
                </div>
            </div>
            <div class="col-md-7">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Clinic</th>
                                <th class="text-end">Patients</th>
                                <th class="text-end">Screenings</th>
                                <th class="text-end">Average score</th>
                                <th class="text-end">Complex</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.ClinicTotals)
                            {
                                <tr class="@(c.ClinicId == Model.ClinicId ? "table-active" : "")">
                                    <td><a asp-page="Index" asp-route-clinicId="@c.ClinicId">@c.Name</a></td>
                                    <td class="text-end">@c.Patients</td>
                                    <td class="text-end">@c.Screenings</td>
                                    <td class="text-end">@c.AverageMenoLikelihood</td>
                                    <td class="text-end">@c.ComplexCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.ClinicId != null)
                {
                    <a asp-page="Index" class="btn btn-quiet btn-sm mt-3">Show all clinics</a>
                }
            </div>
        </div>
    </section>
}

@if (m.TotalScreenings == 0)
{
    <div class="empty-state">
        <h2>No screenings yet</h2>
        <p>Figures appear here once the first patient has been screened.</p>
        @if (User.IsInRole("Clinician"))
        {
            <a asp-page="/Patients/Index" class="btn btn-primary">Screen a patient</a>
        }
    </div>
}
else
{
    <div class="stat-row">
        <div class="stat"><div class="value">@m.TotalScreenings</div><div class="label">Screenings</div></div>
        <div class="stat"><div class="value">@m.ScreeningsLast30Days</div><div class="label">In the last 30 days</div></div>
        <div class="stat"><div class="value">@m.AverageMenoLikelihood</div><div class="label">Average MenoLikelihood</div></div>
        <div class="stat"><div class="value">@m.ComplexCount</div><div class="label">Safety flags (Complex)</div></div>
        <div class="stat"><div class="value">@m.SelfScreenCount</div><div class="label">Done by QR self-screen</div></div>
        <div class="stat"><div class="value">@m.TotalPatients</div><div class="label">Patients</div></div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-6">
            <section class="panel h-100" aria-labelledby="bands-title">
                <h2 id="bands-title">Triage bands</h2>
                <p class="text-secondary">Final band of every screening.</p>
                @foreach (var b in m.Bands)
                {
                    <div class="hbar">
                        <span>@b.Band</span>
                        <div class="track" role="img" aria-label="@b.Band: @b.Count screenings, @b.Percent percent">
                            <div class="fill" style="width: @b.Percent%; background: var(--band-@b.Band.ToLower())"></div>
                        </div>
                        <span class="num">@b.Count (@b.Percent%)</span>
                    </div>
                }
            </section>
        </div>

        <div class="col-lg-6">
            <section class="panel h-100" aria-labelledby="blocks-title">
                <h2 id="blocks-title">Where symptoms are heaviest</h2>
                <p class="text-secondary">Average severity per symptom block, as a percentage of the maximum.</p>
                @foreach (var b in m.BlockAverages.OrderByDescending(b => b.AveragePercent))
                {
                    <div class="hbar">
                        <span>@b.Block</span>
                        <div class="track" role="img" aria-label="@b.Block: average @b.AveragePercent percent">
                            <div class="fill" style="width: @b.AveragePercent%"></div>
                        </div>
                        <span class="num">@b.AveragePercent%</span>
                    </div>
                }
            </section>
        </div>

        <div class="col-12">
            <section class="panel" aria-labelledby="weekly-title">
                <h2 id="weekly-title">Screenings per week</h2>
                <p class="text-secondary">The last @m.Weekly.Count weeks, starting Mondays.</p>
                <div class="weekly" role="img" aria-label="Screenings per week: @(string.Join(", ", m.Weekly.Select(w => $"{w.WeekStart:d MMM} {w.Count}")))">
                    @foreach (var w in m.Weekly)
                    {
                        <div class="wk">
                            <span class="count">@(w.Count > 0 ? w.Count.ToString() : "")</span>
                            <div class="bar" style="height: @(w.Count * 100 / weekMax)%"></div>
                        </div>
                    }
                </div>
                <div class="weekly-labels" aria-hidden="true">
                    @foreach (var w in m.Weekly)
                    {
                        <span>@w.WeekStart.ToString("d MMM")</span>
                    }
                </div>
            </section>
        </div>
    </div>
}


@section Scripts {
    @if (Model.IsAdmin && Model.ClinicTotals.Any())
    {
        @* Chart.js draws the pie chart. It loads from a public library site (no install needed). *@
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            const clinics = @Html.Raw(pieJson);
            const selectedId = @(Model.ClinicId?.ToString() ?? "null");
            // Official Mandi palette (brand guidelines): Terra, Golden, Coral, Deep Brown, Sun, Flame
            const colours = ['#C94A2B', '#F2C14E', '#F07B54', '#673C33', '#F5A623', '#E8632A'];

            new Chart(document.getElementById('clinicPie'), {
                type: 'pie',
                data: {
                    labels: clinics.map(c => c.name),
                    datasets: [{
                        data: clinics.map(c => c.screenings),
                        backgroundColor: clinics.map((c, i) => colours[i % colours.length]),
                        // The chosen clinic's slice is pulled out a little
                        offset: clinics.map(c => c.id === selectedId ? 18 : 0),
                        borderColor: '#FDF6EC',   // Warm Cream, so the slices have soft gaps
                        borderWidth: 3
                    }]
                },
                options: {
                    plugins: { legend: { position: 'bottom', labels: { font: { family: 'Montserrat' } } } },
                    // Clicking a slice reloads the page showing only that clinic
                    onClick: (event, slices) => {
                        if (slices.length) window.location.search = '?clinicId=' + clinics[slices[0].index].id;
                    },
                    onHover: (event, slices) => {
                        event.native.target.style.cursor = slices.length ? 'pointer' : 'default';
                    }
                }
            });
        </script>
    }
}
