@page "{versionId:int}"
@model MenoScreen.Pages_Questions.CreateModel
@{
    ViewData["Title"] = "Add question";
}

<h1>Add question to version @Model.VersionNumber</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Type" class="form-label"></label>
        <select asp-for="Input.Type" class="form-select"
                asp-items="Html.GetEnumSelectList<MenoScreen.Models.QuestionType>()"></select>
        <div class="form-text">Scored = rated 0-3. Context = not scored, has answer options. SafetyFlag = the Yes/No question (one per version).</div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Block" class="form-label"></label>
        <select asp-for="Input.Block" class="form-select" asp-items="new SelectList(Model.Blocks)">
            <option value="">Select a block...</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewBlock" class="form-label"></label>
        <input asp-for="Input.NewBlock" class="form-control" />
        <div class="form-text">Leave empty to use the block chosen above.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Text" class="form-label"></label>
        <input asp-for="Input.Text" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.Options" class="form-label"></label>
        <input asp-for="Input.Options" class="form-control" />
        <div class="form-text">Context questions only. Separate choices with |  for example: Yes|No|Not sure</div>
    </div>

    <div class="row">
        <div class="col mb-3">
            <label asp-for="Input.Number" class="form-label"></label>
            <input asp-for="Input.Number" class="form-control" />
        </div>
        <div class="col mb-3">
            <label asp-for="Input.SortOrder" class="form-label"></label>
            <input asp-for="Input.SortOrder" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Add question</button>
    <a asp-page="/Versions/Details" asp-route-id="@Model.VersionId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}