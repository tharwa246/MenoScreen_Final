@page
@model MenoScreen.Pages_Questions.DeleteModel

@{
    ViewData["Title"] = "Delete question";
}

<a class="back-link" asp-page="./Index">Back to questions</a>

<div class="page-head pt-3">
    <div>
        <h1>Delete question @Model.Question.Number?</h1>
        <p>Every saved answer to this question is deleted with it, which changes past results. Usually it's safer to create a new question-set version instead.</p>
    </div>
</div>
<div class="panel">
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.QuestionSetVersion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.QuestionSetVersion.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Number)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Number)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.SortOrder)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.SortOrder)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Block)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Block)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Text)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Text)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Type)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Type)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Options)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Options)
        </dd>
    </dl>
    
    <form method="post" class="form-actions">
        <input type="hidden" asp-for="Question.Id" />
        <button type="submit" class="btn btn-danger">Delete question</button>
        <a asp-page="./Index" class="btn btn-quiet">Keep it</a>
    </form>
</div>
