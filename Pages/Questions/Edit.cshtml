@page
@model MenoScreen.Pages_Questions.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Question</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Question.Id" />
            <input type="hidden" asp-for="Question.QuestionSetVersionId" />
            <div class="form-group">
                <label asp-for="Question.Number" class="control-label"></label>
                <input asp-for="Question.Number" class="form-control" />
                <span asp-validation-for="Question.Number" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Question.SortOrder" class="control-label"></label>
                <input asp-for="Question.SortOrder" class="form-control" />
                <span asp-validation-for="Question.SortOrder" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Question.Block" class="control-label"></label>
                <input asp-for="Question.Block" class="form-control" />
                <span asp-validation-for="Question.Block" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Question.Text" class="control-label"></label>
                <input asp-for="Question.Text" class="form-control" />
                <span asp-validation-for="Question.Text" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Question.Type" class="control-label"></label>
                <select asp-for="Question.Type" class="form-control" 
                asp-items="Html.GetEnumSelectList<MenoScreen.Models.QuestionType>()"></select>
                <span asp-validation-for="Question.Type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Question.Options" class="control-label"></label>
                <input asp-for="Question.Options" class="form-control" />
                <span asp-validation-for="Question.Options" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
