@page
@model MenoScreen.Pages_Questions.EditModel
@using MenoScreen.Models

@{
    ViewData["Title"] = "Edit question";
}

<a class="back-link" asp-page="./Index">Back to questions</a>

<div class="page-head pt-3">
    <div>
        <h1>Edit question @Model.Question.Number</h1>
        <p>Changing wording changes what every future patient sees. Past screenings keep their answers.</p>
    </div>
</div>

<form method="post" class="panel form-narrow">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Question.Id" />

    <div class="mb-3">
        <label asp-for="Question.Text" class="form-label">Question wording</label>
        <textarea asp-for="Question.Text" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Question.Text" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Question.Block" class="form-label">Symptom block</label>
        <input asp-for="Question.Block" class="form-control" />
        <span asp-validation-for="Question.Block" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Question.Type" class="form-label">Type</label>
        <select asp-for="Question.Type" class="form-select" asp-items="Html.GetEnumSelectList<QuestionType>()"></select>
        <span asp-validation-for="Question.Type" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Question.Options" class="form-label">Answer options (context questions only)</label>
        <input asp-for="Question.Options" class="form-control" />
        <div class="form-text">Separate options with a | character, for example: Yes|No|Not sure</div>
        <span asp-validation-for="Question.Options" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-6 mb-3">
            <label asp-for="Question.Number" class="form-label">Number</label>
            <input asp-for="Question.Number" class="form-control" />
            <span asp-validation-for="Question.Number" class="text-danger"></span>
        </div>
        <div class="col-6 mb-3">
            <label asp-for="Question.SortOrder" class="form-label">Sort order</label>
            <input asp-for="Question.SortOrder" class="form-control" />
            <span asp-validation-for="Question.SortOrder" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Question.QuestionSetVersionId" class="form-label">Question-set version</label>
        <select asp-for="Question.QuestionSetVersionId" class="form-select" asp-items="ViewBag.QuestionSetVersionId"></select>
        <span asp-validation-for="Question.QuestionSetVersionId" class="text-danger"></span>
    </div>

    <div class="form-actions mt-2">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-page="./Index" class="btn btn-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
