@page
@model MenoScreen.Pages_Questions.IndexModel

@{
    ViewData["Title"] = "Screening questions";
}

<div class="page-head">
    <div>
        <h1>Screening questions</h1>
        <p>Grouped by symptom block, in the order patients see them. Scored questions are rated 0 to 3.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Add question</a>
</div>

@foreach (var version in Model.Question.GroupBy(q => q.QuestionSetVersion).OrderByDescending(g => g.Key.VersionNumber))
{
    <h2 class="mt-4">
        Version @version.Key.VersionNumber
        @if (version.Key.IsActive)
        {
            <span class="tag ms-2 align-middle">Active</span>
        }
    </h2>
    @if (!string.IsNullOrWhiteSpace(version.Key.Notes))
    {
        <p class="text-secondary">@version.Key.Notes</p>
    }

    <div class="table-panel">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Question</th>
                    <th scope="col">Block</th>
                    <th scope="col">Type</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in version.OrderBy(q => q.SortOrder))
                {
                    <tr>
                        <td>@item.Number</td>
                        <td>
                            @item.Text
                            @if (!string.IsNullOrWhiteSpace(item.Options))
                            {
                                <div class="small text-secondary">Options: @item.Options.Replace("|", ", ")</div>
                            }
                        </td>
                        <td>@item.Block</td>
                        <td><span class="tag">@item.Type</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a>
                            <span class="text-secondary mx-1">|</span>
                            <a asp-page="./Details" asp-route-id="@item.Id">View</a>
                            <span class="text-secondary mx-1">|</span>
                            <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
