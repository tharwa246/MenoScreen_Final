@page
@model MenoScreen.Pages_Questions.DetailsModel

@{
    ViewData["Title"] = "Question details";
}

<a class="back-link" asp-page="./Index">Back to questions</a>

<div class="page-head pt-3">
    <div><h1>Question @Model.Question.Number</h1></div>
</div>

<div class="panel">
    <dl class="row mb-0">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.QuestionSetVersion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.QuestionSetVersion.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Number)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Number)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.SortOrder)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.SortOrder)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Block)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Block)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Text)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Text)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Type)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Type)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Options)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Options)
        </dd>
    </dl>
</div>
<div class="form-actions">
    <a asp-page="./Edit" asp-route-id="@Model.Question.Id" class="btn btn-primary">Edit question</a>
</div>
