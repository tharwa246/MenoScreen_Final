<div id="consultationTimer" class="consultation-timer" aria-live="polite">
    <span>Consultation time:</span>
    <strong id="consultationTimerDisplay">00:00:00</strong>

    <button type="button" id="startConsultationTimer">
        Start
    </button>

    <button type="button" id="pauseConsultationTimer" disabled>
        Pause
    </button>

    <button type="button" id="resetConsultationTimer">
        Reset
    </button>
</div>