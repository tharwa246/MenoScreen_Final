@* THE 23 QUESTIONS, shared by the clinician form (Screenings/New), "screen without saving"
   (Screenings/Unsaved) and the patient QR page (SelfScreen).
   How the answers reach the server: each radio button is named like Answers[15], where 15 is
   the question's Id. ASP.NET collects all of them into the page's Answers dictionary
   (QuestionId -> 0, 1, 2 or 3). The drop-downs for Q1-Q4 fill TextAnswers the same way.
   "required" on the first radio of each question stops the form being sent with a gap.
   LANGUAGE: questions are shown in Model.Language using Tharwa's TranslationHelper, which falls
   back to English for anything not translated. The VALUES sent back are always English. *@
@model MenoScreen.Pages.Shared.QuestionFormModel
@using MenoScreen.Models
@using MenoScreen.Pages.Shared
@using MenoScreen.Services

@{
    // The rating instructions are shown once, above the FIRST scored section only
    var firstScoredBlock = Model.Questions.FirstOrDefault(q => q.Type == QuestionType.Scored)?.Block;

    string[] scale =
    {
        Model.T("Scale0", QuestionFormModel.RatingLabels[0]),
        Model.T("Scale1", QuestionFormModel.RatingLabels[1]),
        Model.T("Scale2", QuestionFormModel.RatingLabels[2]),
        Model.T("Scale3", QuestionFormModel.RatingLabels[3])
    };
}

@foreach (var block in Model.Questions.GroupBy(q => q.Block))
{
    var type = block.First().Type;
    // The block heading in her language (falls back to English)
    var blockTitle = TranslationHelper.Localize(block.First(), Model.Language).Block;

    <section class="q-block" aria-labelledby="block-@block.First().Id">
        <h2 id="block-@block.First().Id">@blockTitle</h2>

        @if (type == QuestionType.Scored && block.Key == firstScoredBlock)
        {
            @if (Model.SelfScreen)
            {
                <p class="script-note">For each one, choose how much it has been affecting you lately.</p>
            }
            else
            {
                <p class="script-note">Say to her: "@Model.T("ScaleIntro", "I'd like you to rate how much each symptom has been affecting you: 0 means not at all, 1 a little, 2 quite a bit, and 3 extremely.")"</p>
            }
        }

        @foreach (var question in block)
        {
            // The question in her language: text and option LABELS translated, option VALUES English
            var q = TranslationHelper.Localize(question, Model.Language);

            <fieldset class="question">
                <legend><span class="qnum">@q.Number.</span>@q.Text</legend>

                @if (q.Type == QuestionType.Context)
                {
                    <label class="visually-hidden" for="ctx-@q.Id">Answer to question @q.Number</label>
                    <select id="ctx-@q.Id" name="TextAnswers[@q.Id]" class="form-select" style="max-width: 24rem" required>
                        <option value="">@Model.T("Select", "Choose an answer")</option>
                        @foreach (var option in q.Options)
                        {
                            <option value="@option.Value" selected="@(Model.TextAnswers.GetValueOrDefault(q.Id) == option.Value)">@option.Label</option>
                        }
                    </select>
                }
                else if (q.Type == QuestionType.Scored)
                {
                    <div class="rating">
                        @for (int i = 0; i <= 3; i++)
                        {
                            var id = $"q{q.Id}_{i}";
                            <input type="radio" id="@id" name="Answers[@q.Id]" value="@i" required="@(i == 0)"
                                   checked="@(Model.Answers.TryGetValue(q.Id, out var picked) && picked == i)" />
                            <label for="@id"><span class="num">@i</span>@scale[i]</label>
                        }
                    </div>
                }
                else
                {
                    <div class="rating">
                        <input type="radio" id="q@(q.Id)_yes" name="Answers[@q.Id]" value="1" required
                               checked="@(Model.Answers.TryGetValue(q.Id, out var s1) && s1 == 1)" />
                        <label for="q@(q.Id)_yes">@Model.T("Yes", "Yes")</label>
                        <input type="radio" id="q@(q.Id)_no" name="Answers[@q.Id]" value="0"
                               checked="@(Model.Answers.TryGetValue(q.Id, out var s0) && s0 == 0)" />
                        <label for="q@(q.Id)_no">@Model.T("No", "No")</label>
                    </div>
                }
            </fieldset>
        }
    </section>
}